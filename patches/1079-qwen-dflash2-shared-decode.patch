+    defer done.deinit(a);
+    try measured(&e, &done, 60);
+    try own.keep(a, &e.lone_kept[0][0], &done);
+    var next = try Stream.init(a, .{ .id = "next", .prompt = &.{ 2, 7 }, .max_new = 128 });
