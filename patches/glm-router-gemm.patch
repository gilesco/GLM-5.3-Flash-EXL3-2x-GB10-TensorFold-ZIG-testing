+
+// the same, reading a gate's K slice out of rows [N][src_stride] (PATCH glm-router-gemm:
+// each MoE gate's 8 slices tiled at load; src arrives offset to the slice's first input)
+extern "C" __global__ void glm_mm_tile16s(const __nv_bfloat16* __restrict__ src, __nv_bfloat16* __restrict__ dst, int N, int K, long long src_stride) {
+    const int KG = K >> 6, N8 = N >> 3;
+    const long long c = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= (long long)N8 * KG * 32) return;
+    const int lane = (int)(c & 31);
+    const long long tg = c >> 5;
+    const int g = (int)(tg % KG), tt = (int)(tg / KG);
+    const int n = tt * 8 + (lane >> 2);
+#pragma unroll
+    for (int v = 0; v < 16; ++v) dst[c * 16 + v] = src[(long long)n * src_stride + g * 64 + frag_k(lane, v)];
+}
