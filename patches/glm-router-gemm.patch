+
+// glue._router_mm: one prompt router K slice as glm_mm's staged 128-row tile GEMM with a
+// continuous mma chain. PATCH glm-router-gemm: the hand-rolled router kernels read x and w
+// straight out of global memory at every mma step (latency-exposed, 72 small blocks at
+// m=2048); this kernel keeps their exact arithmetic — the same canonical m16n8k16
+// fragments, the same ascending k16 order from zero, one fp32 chain per output per slice,
+// slice_sum adding the slices in the same order — so the summed logits are bit-identical
+// (the content gate verifies), while every load stages through cp.async in 128-row blocks
+// that share each weight tile in L2 (glm_mm16_rows' shape, ROWS_FIRST). One launch per
+// slice; w is the slice's tiled layout (glm_mm_tile16s at load); out is the slice's
+// fp32 region of the part buffer.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_glm_router_mm(const __nv_bfloat16* x, long long ldx, const uint32_t* __restrict__ w,
+                     float* __restrict__ out, int M, int N, int K) {
+  constexpr int BM = 128, WM = 2, WN = 4, NT = 2, MT = BM / WM / 16, ROW = 128, CHUNKS = 8, WPC = 8;
+  constexpr int XS = BM * ROW, WB = 8 * 32 * WPC * 4, STAGE = XS + WB + 128, STAGES = 3;
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+  const int wm = warp / WN, wn = warp % WN;
+  const int KG = K >> 6;
+  const int n0 = blockIdx.y * 64, m0 = blockIdx.x * BM;   // row blocks fastest: a prompt's rows share each weight tile in L2
+  const int t0 = n0 >> 3;
+  extern __shared__ __align__(128) unsigned char buf[];
+  auto stage = [&](int st) { return buf + st * STAGE; };
+  auto loadX = [&](int st, int g) {
+    unsigned char* p = stage(st);
+    for (int c = tid; c < BM * CHUNKS; c += 256) {
+      const int r = c / CHUNKS, ch = c % CHUNKS;
+      const int row = min(m0 + r, M - 1);
+      qmm_frag::cp16z(p + r * ROW + qmm_frag::swz<CHUNKS>(r, ch) * 16, x + (long long)row * ldx + g * 64 + ch * 8, m0 + r < M);
+    }
+  };
+  auto loadW = [&](int st, int g) {
+    unsigned char* pw = stage(st) + XS;
+    constexpr int PER_TILE = 32 * WPC * 4 / 16;
+    for (int c = tid; c < 8 * PER_TILE; c += 256) {
+      const int tt = c / PER_TILE, off = c % PER_TILE;
+      if (t0 + tt >= (N + 7) / 8) continue;
+      const long long src = ((long long)(t0 + tt) * KG + g) * 32 * WPC * 4 + off * 16;
+      qmm_frag::cp16(pw + c * 16, reinterpret_cast<const unsigned char*>(w) + src);
+    }
+  };
+  float acc[MT][NT][4];
+#pragma unroll
+  for (int i = 0; i < MT; ++i)
+#pragma unroll
+    for (int j = 0; j < NT; ++j)
+#pragma unroll
+      for (int e = 0; e < 4; ++e) acc[i][j][e] = 0.0f;
+  qmm_frag::grid_launch();
+#pragma unroll
+  for (int st = 0; st < STAGES - 1; ++st)
+    if (st < KG) loadW(st, st);
+  qmm_frag::grid_wait();
+#pragma unroll
+  for (int st = 0; st < STAGES - 1; ++st) {
+    if (st < KG) loadX(st, st);
+    qmm_frag::commit();
+  }
+  for (int it = 0; it < KG; ++it) {
+    qmm_frag::wait<STAGES - 2>();
+    __syncthreads();
+    const int next = it + STAGES - 1;
+    if (next < KG) {
+      loadX(next % STAGES, next);
+      loadW(next % STAGES, next);
+    }
+    qmm_frag::commit();
+    const unsigned char* p = stage(it % STAGES);
+    const uint32_t* pw = reinterpret_cast<const uint32_t*>(p + XS);
+    uint32_t b[NT][8];
+#pragma unroll
+    for (int j = 0; j < NT; ++j)
+#pragma unroll
+      for (int i = 0; i < 8; ++i) b[j][i] = pw[((wn * NT + j) * 32 + lane) * WPC + i]; // bf16 pairs: the staged chunk words are the fragment pairs in order
+#pragma unroll
+    for (int kt = 0; kt < 4; ++kt) {
+      uint32_t a[MT][4];
+#pragma unroll
+      for (int i = 0; i < MT; ++i) {
+        const int r = wm * (BM / WM) + i * 16 + (lane & 7) + ((lane >> 3) & 1) * 8;
+        const int ch = kt * 2 + (lane >> 4);
+        qmm_frag::ldmatrix4(a[i], p + r * ROW + qmm_frag::swz<CHUNKS>(r, ch) * 16);
+      }
+#pragma unroll
+      for (int j = 0; j < NT; ++j)
+#pragma unroll
+        for (int i = 0; i < MT; ++i) qmm_frag::mma(acc[i][j], a[i], b[j][2 * kt], b[j][2 * kt + 1]);
+    }
+  }
+  qmm_frag::wait<0>();
+#pragma unroll
+  for (int j = 0; j < NT; ++j) {
+    const int col = n0 + (wn * NT + j) * 8 + (lane & 3) * 2;
+    if (col >= N) continue;
+#pragma unroll
+    for (int i = 0; i < MT; ++i)
+#pragma unroll
+      for (int h = 0; h < 2; ++h) {
+        const int row = m0 + wm * (BM / WM) + i * 16 + (lane >> 2) + h * 8;
+        if (row < M) {
+          float* dst = out + (long long)row * N + col;
+          dst[0] = acc[i][j][2 * h];
+          dst[1] = acc[i][j][2 * h + 1];
+        }
+      }
+  }
+}
