+// glue._hc_pre_fused: hcPre's two-kernel chain (a partial kernel + the finish) in ONE launch.
+// PATCH glm-hc-fuse: a block per row, 256 threads — two 128-thread groups walk the nb K-blocks'
+// steps (tf_glm_hc_partial8's exact per-step ops, extended over all blocks; group g takes steps
+// {g, g+2, ...}), the partials land in shared memory in the finish's `part` row layout (24 dots,
+// the block's ss at [24]), and glm_hc::finish_row runs verbatim on them. The same ops in the same
+// order as the chain — the per-step 16-lane reduce is self-contained (the group split cannot move
+// an add), the dots reduce in ascending step order (the chain's acc), the ss keeps the warp
+// butterfly and the (0+2)+(1+3) combine, and the finish's body is the template, unmodified —
+// bit-identical outputs by construction. The f32w sibling reads the norm weight as float32.
+template <typename W>
+__device__ __forceinline__ void hc_pre_fused(const __nv_bfloat16* x, const __nv_bfloat16* fn,
+                                             const float* base, const float* scale, const W* nw,
+                                             __nv_bfloat16* out, float* xs, float* post, float* comb,
+                                             float eps, float hc_eps, int nb, int iters, int64_t wide) {
+  const int64_t r = blockIdx.x;
+  const int steps = static_cast<int>(wide / nb / 128);
+  const int grp = threadIdx.x >> 7, t = threadIdx.x & 127, c = t & 15, m0 = (t >> 4) & 7;
+  __shared__ float dots[16][8][24];  // [block][step][dot]: 8 steps of 128, as tf_glm_hc_partial8
+  __shared__ float ssw[16][4];
+  __shared__ float dtot[16][32];     // this row's `part` layout: 24 dots + the ss at [24]
+  for (int b = 0; b < nb; ++b) {
+    for (int st = grp; st < steps; st += 2) {
+      const int64_t base_off = b * (wide / nb) + st * 128;
+      float xv[8];
+      {
+        const uint4 u = *reinterpret_cast<const uint4*>(x + r * wide + base_off + c * 8);
+        const __nv_bfloat16* h = reinterpret_cast<const __nv_bfloat16*>(&u);
+        for (int j = 0; j < 8; ++j) xv[j] = bf(h[j]);
+      }
+      for (int i = 0; i < 3; ++i) {
+        const uint4 u = __ldg(reinterpret_cast<const uint4*>(fn + (int64_t)(m0 + 8 * i) * wide + base_off + c * 8));
+        const __nv_bfloat16* w = reinterpret_cast<const __nv_bfloat16*>(&u);
+        float d = __fmul_rn(xv[1], bf(w[1]));
+        d = __fmaf_rn(xv[0], bf(w[0]), d);
+        for (int j = 2; j < 8; ++j) d = __fmaf_rn(xv[j], bf(w[j]), d);
+        for (int o = 8; o > 0; o >>= 1) d = d + __shfl_xor_sync(0xffffffffu, d, o);
+        if (c == 0) dots[b][st][m0 + 8 * i] = d;
+      }
+    }
+  }
+  if (grp == 0) {
+    for (int b = 0; b < nb; ++b) {
+      float sacc = 0.0f;
+      for (int st = 0; st < steps; ++st) {
+        const float xt = bf(x[r * wide + b * (wide / nb) + st * 128 + t]);
+        sacc = __fmaf_rn(xt, xt, sacc);
+      }
+      for (int o = 16; o > 0; o >>= 1) sacc += __shfl_xor_sync(0xffffffffu, sacc, o);
+      if ((t & 31) == 0) ssw[b][t >> 5] = sacc;
+    }
+  }
+  __syncthreads();
+  if (threadIdx.x < 24) {
+    for (int b = 0; b < nb; ++b) {
+      float acc = 0.0f;
+      for (int st = 0; st < steps; ++st) acc = acc + dots[b][st][threadIdx.x];
+      dtot[b][threadIdx.x] = acc;
+    }
+  } else if (threadIdx.x == 24) {
+    for (int b = 0; b < nb; ++b) dtot[b][24] = (ssw[b][0] + ssw[b][2]) + (ssw[b][1] + ssw[b][3]);
+  }
+  __syncthreads();
+  glm_hc::finish_row(x, dtot[0], base, scale, nw, out, xs, post, comb, eps, hc_eps, nb, iters, r);
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+    tf_glm_hc_pre_fused(const __nv_bfloat16* x, const __nv_bfloat16* fn, const float* base, const float* scale,
+                        const __nv_bfloat16* nw, __nv_bfloat16* out, float* xs, float* post, float* comb, float eps,
+                        float hc_eps, int nb, int iters, int64_t wide) {
+  hc_pre_fused(x, fn, base, scale, nw, out, xs, post, comb, eps, hc_eps, nb, iters, wide);
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+    tf_glm_hc_pre_fused_f32w(const __nv_bfloat16* x, const __nv_bfloat16* fn, const float* base, const float* scale,
+                             const float* nw, __nv_bfloat16* out, float* xs, float* post, float* comb, float eps,
+                             float hc_eps, int nb, int iters, int64_t wide) {
+  hc_pre_fused(x, fn, base, scale, nw, out, xs, post, comb, eps, hc_eps, nb, iters, wide);
 }
