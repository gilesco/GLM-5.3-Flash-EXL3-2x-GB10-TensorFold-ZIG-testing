+    std.log.info("glm: load: the checkpoint opened at {d:.1} s", .{@as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - bt0.toNanoseconds())) / 1e9});
     w.layers = try gpa.alloc(Layer, layers.len);
