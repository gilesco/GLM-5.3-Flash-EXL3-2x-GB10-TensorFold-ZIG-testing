#! glm-boot-marks2.patch — the phase marks PLUS per-tensor timing (round 126).
#! add() marks the read (the map's faults + the host copy) per tensor; put() marks
#! the device alloc + H2D per tensor. One pristine boot then answers where the
#! 45-layer loop's ~4.1 s/layer sits. ~4000 short lines per boot. Logging only.
--- a/zig/src/families/glm/cuda_weights.zig
+++ b/zig/src/families/glm/cuda_weights.zig
@@ -84,6 +84,7 @@
     w: *Weights,
     ck: *core.Checkpoint,
     host: std.ArrayList(u8) = .empty,
+    io: std.Io, // glm-boot-marks2: the per-tensor marks' clock
     name_buf: [192]u8 = undefined,
     last: []const u8 = "", // the tensor `get` read last, named when its values are refused
     recipes: ?*const core.modelopt.Recipes = null, // MIXED_PRECISION's table; null: the tensors decide (NVFP4)
@@ -144,13 +145,21 @@
 
     /// The host bytes gathered so far uploaded as one tensor named `fmt`.
     pub fn put(L: *Loader, comptime fmt: []const u8, args: anytype) !u64 {
+        const pt0 = std.Io.Clock.awake.now(L.io); // glm-boot-marks2: the upload's own cost
         const ptr = try @import("cuda_upload_owner.zig").keep(L, try cuda.DeviceBuffer.fromHost(L.d, L.host.items), fmt, args);
+        var nb: [192]u8 = undefined;
+        std.log.info("glm: put {s} {d} KiB {d:.0} ms", .{ std.fmt.bufPrint(&nb, fmt, args) catch "?", L.host.items.len >> 10, @as(f64, @floatFromInt(std.Io.Clock.awake.now(L.io).toNanoseconds() - pt0.toNanoseconds())) / 1e6 });
         L.host.clearRetainingCapacity();
         return ptr;
     }
 
     /// Elements [lo, hi) of `t` flat as `to` (bf16 or fp32 from a bf16 or fp32 tensor; other dtypes only as stored).
     fn add(L: *Loader, t: Tensor, lo: usize, hi: usize, to: core.checkpoint.DType) !void {
+        const at0 = std.Io.Clock.awake.now(L.io); // glm-boot-marks2: the read's own cost (the map's faults + the host copy)
+        defer {
+            const esz = t.bytes.len / t.numel();
+            std.log.info("glm: add {s} {d} KiB {d:.0} ms", .{ L.last, (hi - lo) * esz >> 10, @as(f64, @floatFromInt(std.Io.Clock.awake.now(L.io).toNanoseconds() - at0.toNanoseconds())) / 1e6 });
+        }
         if (t.dtype == to) {
             const size = t.bytes.len / t.numel();
             return L.host.appendSlice(L.gpa, t.bytes[lo * size .. hi * size]);
